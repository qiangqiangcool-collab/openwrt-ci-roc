CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# Router administration and the services that already form point6's control
# plane. OpenClash and AdGuard Home come from the pinned LuCI/packages feeds.
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_haproxy=y
CONFIG_PACKAGE_openssh-sftp-server=y

# Existing IEEE 802.3ad/LACP network configuration needs both the kernel module
# and the netifd protocol handler after the firmware transition.
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_proto-bonding=y

# Docker 29.6.1 and LuCI management. Home Assistant will use host networking,
# while Docker iptables integration is disabled by the first-boot guard.
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_DOCKER_CGROUP_OPTIONS=y
CONFIG_DOCKER_NET_MACVLAN=y
CONFIG_DOCKER_STO_EXT4=y
# CONFIG_DOCKER_OPTIONAL_FEATURES is not set
# CONFIG_DOCKER_NET_OVERLAY is not set
# CONFIG_DOCKER_STO_BTRFS is not set

# Dedicated ext4 data-partition support. Docker and Home Assistant state must
# be mounted at /mnt/docker instead of consuming the firmware overlay.
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_lsblk=y

# Small operational toolset required by the retained point6 maintenance scripts.
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_coreutils-stat=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tmux=y

# No wireless stack is carried in this wired-only image.
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_hostapd-common=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-cs-02=n
